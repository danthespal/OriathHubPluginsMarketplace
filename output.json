    {
      "Name": "HealthBars",
      "OriginalAuthor": "OriathHub",
      "Forks": [
        {
          "Author": "danthespal",
          "Location": "danthespal",
          "Name": "HealthBars",
          "LatestCommit": {
            "Message": "DPS Readout\n\n- Live DPS meter under monster health bars, showing effective HP drained per second (Energy Shield \u002B Life \u002B Ward combined). Enable per rarity/type (white, magic, rare, unique, friendly)\n- Gross-drain measurement over a configurable sliding window - counts damage only, so monster regen / ES recharge / ward refresh don\u0027t distort the number. Reads your damage output.",
            "Hash": "09135abfe03c2a9790db416f3e78eff93f5b41b9",
            "Author": "danthespal",
            "Date": "2026-07-06T23:14:21Z"
          },
          "Releases": []
        }
      ],
      "Description": "Draw health, energy shield, mana and ward bars above entities in the game world. Supports customisable bar style and per-monster-type visibility rules.",
      "EndorsedAuthor": "danthespal"
    },
